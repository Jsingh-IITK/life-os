{
  "name": "life-os",
  "version": "0.0.0",
  "private": true,
  "description": "Personal Life OS \u2014 modular personal management. Finance and Fitness as first-class modules.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "lint": "eslint .",
    "mobile": "pnpm --filter @life-os/mobile start",
    "mobile:web": "pnpm --filter @life-os/mobile web",
    "mobile:android": "pnpm --filter @life-os/mobile android",
    "db:push": "supabase db push --remote",
    "db:test": "supabase test db",
    "smoke": "node scripts/smoke.mjs",
    "check:plans": "node scripts/check-plans.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "playwright": "^1.65.1",
    "supabase": "^3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.1.1"
  }
}
