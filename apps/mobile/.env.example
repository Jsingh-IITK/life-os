# Copy to apps/mobile/.env and fill in from your Supabase project:
#   Project Settings -> API
#
# Both values are publishable: the anon key has no privileges of its own and is
# constrained entirely by Row Level Security. They are still kept out of git so
# the repo is not tied to one project.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service role key in this file or anywhere under apps/.
# It bypasses RLS. It belongs only in Supabase Edge Function secrets.
